<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".ViewerActivity">

    <!-- 底层：全图预览，改用 ViewPager2 实现平滑切换和边缘联动 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/photoViewPager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/statusBar"
        layout="@layout/layout_status_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 顶层悬浮：右侧控制面板 (半透明) -->
    <LinearLayout
        android:id="@+id/sidePanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 100% 细节框 (变大) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/focusCheckCard"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            app:cardBackgroundColor="#000000"
            app:cardCornerRadius="4dp">

            <ImageView
                android:id="@+id/focusCheckImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:background="#80000000"
                android:padding="2dp"
                android:text="100% Focus Check"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </androidx.cardview.widget.CardView>

        <!-- EXIF 信息区 -->
        <LinearLayout
            android:id="@+id/exifContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/exifInfoTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="f/--  1/--s  ISO --"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 填充空间 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 导航按钮 -->
        <Button
            android:id="@+id/btnGallery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GALLERY"
            android:textSize="12sp"
            android:backgroundTint="#444444"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
